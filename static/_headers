# Cloudflare Pages response headers

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted CSS never changes under the same name
/css/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/files/*
  Cache-Control: public, max-age=604800
  X-Robots-Tag: noindex

# Only uo.wzk.cz should be indexed — keep the pages.dev hostnames out of search
https://uo-wzk-cz.pages.dev/*
  X-Robots-Tag: noindex

https://:version.uo-wzk-cz.pages.dev/*
  X-Robots-Tag: noindex
